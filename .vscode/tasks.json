{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run All Unit Tests",
            "type": "shell",
            "command": "dotnet test --filter FullyQualifiedName~.Unit.",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "Update All Packages",
            "detail": "Updates all NuGet packages in the solution to their latest versions.",
            "type": "shell",
            "command": "find . -name '*.csproj' -exec dotnet package update --project \"{}\" \\;",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        }
    ]
}
